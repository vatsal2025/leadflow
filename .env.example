# Copy to .env. Compose reads this file; local API also loads it.
APP_ENV=development
DATABASE_URL=sqlite:///./leadflow.db
PUBLIC_ORIGIN=http://localhost:3000
# Optional locally; REQUIRED in production (at least 16 characters).
APP_PASSWORD=
# REQUIRED with APP_PASSWORD (at least 32 characters; use a random secret).
SESSION_SECRET=
# Set true when the site is served over HTTPS.
COOKIE_SECURE=false
# Next.js server only. Local API URL; Compose overrides this internally.
API_INTERNAL_URL=http://127.0.0.1:8000
# PostgreSQL credentials for Compose. Set a strong password before use.
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=leadflow
# Optional: local production server bind address (keep loopback for local use).
LEADFLOW_HOST=127.0.0.1
# True on serverless hosts: PostgreSQL only, one pooled connection per instance.
SERVERLESS=false
# Exact public backend hostname when hosted separately (no scheme).
API_HOSTNAME=
